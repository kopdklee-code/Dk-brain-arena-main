{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "*.log", "firebase-debug.log"],
      "predeploy": ["node \"$PROJECT_DIR/scripts/build.mjs\" functions"]
    }
  ],
  "hosting": {
    "public": "dist/hosting",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["node \"$PROJECT_DIR/scripts/build.mjs\" hosting"],
    "headers": [
      { "source": "**/*.@(js|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "emulators": {
    "auth": { "host": "127.0.0.1", "port": 9099 },
    "firestore": { "host": "127.0.0.1", "port": 8080 },
    "functions": { "host": "127.0.0.1", "port": 5001 },
    "hosting": { "host": "127.0.0.1", "port": 5000 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
